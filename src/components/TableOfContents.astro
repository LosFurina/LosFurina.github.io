---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;

// Filter to only show h2 and h3
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// Compute h2 index for numbering
let h2Index = 0;
const tocWithIndex = toc.map((h) => {
    if (h.depth === 2) {
        h2Index++;
        return { ...h, index: h2Index };
    }
    return { ...h, index: null };
});
---

{
    toc.length > 0 && (
        <nav class="toc-nav" aria-label="Table of Contents">
            <div class="toc-header">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    width="16"
                    height="16"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
                    />
                </svg>
                <span>目录</span>
            </div>
            <div class="toc-entries" id="toc-entries">
                {tocWithIndex.map((heading) => (
                    <a
                        href={`#${heading.slug}`}
                        class:list={[
                            "toc-entry",
                            { "toc-entry--sub": heading.depth === 3 },
                        ]}
                        data-heading-id={heading.slug}
                    >
                        {heading.depth === 2 ? (
                            <div class="toc-badge toc-badge--number">
                                {heading.index}
                            </div>
                        ) : (
                            <div class="toc-badge toc-badge--dot">
                                <div class="toc-dot" />
                            </div>
                        )}
                        <div class="toc-text">{heading.text}</div>
                    </a>
                ))}
                <div id="toc-active-indicator" class="toc-active-indicator" />
            </div>
        </nav>
    )
}

<style>
    .toc-nav {
        padding: 0.75rem;
        font-size: 0.85rem;
    }

    .toc-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.5rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: rgb(var(--gray));
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .toc-entries {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .toc-entry {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        min-height: 2.25rem;
        border-radius: 0.75rem;
        text-decoration: none;
        color: rgb(var(--gray));
        transition: all 0.2s ease;
        position: relative;
        z-index: 1;
    }

    .toc-entry:hover {
        background: var(--toc-btn-hover, rgba(var(--accent-rgb), 0.08));
        color: rgb(var(--gray-dark));
    }

    .toc-entry:active {
        background: var(--toc-btn-active, rgba(var(--accent-rgb), 0.14));
    }

    .toc-entry.active {
        color: rgb(var(--gray-dark));
        font-weight: 500;
    }

    .toc-entry--sub {
        padding-left: 0.5rem;
    }

    .toc-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

    .toc-badge--number {
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 0.5rem;
        font-size: 0.7rem;
        font-weight: 700;
        background: var(--toc-badge-bg, rgba(var(--accent-rgb), 0.15));
        color: var(--accent);
    }

    .toc-badge--dot {
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 0.5rem;
        margin-left: 1rem;
    }

    .toc-dot {
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 0.125rem;
        background: var(--toc-badge-bg, rgba(var(--accent-rgb), 0.3));
        transition: all 0.2s ease;
    }

    .toc-text {
        font-size: 0.82rem;
        line-height: 1.4;
        transition: color 0.2s ease;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .toc-active-indicator {
        position: absolute;
        left: 0;
        right: 0;
        border-radius: 0.75rem;
        background: var(--toc-btn-hover, rgba(var(--accent-rgb), 0.08));
        border: 1.5px dashed var(--toc-indicator-border, rgba(var(--accent-rgb), 0.25));
        z-index: 0;
        opacity: 0;
        transition:
            top 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.2s ease;
        pointer-events: none;
    }

    .toc-entries:hover .toc-active-indicator {
        background: transparent;
        border-color: var(--toc-indicator-border, rgba(var(--accent-rgb), 0.35));
    }

    @media (max-width: 1200px) {
        .toc-nav {
            margin-bottom: 1.5rem;
        }
    }
</style>

<script>
    class TOCHighlighter {
        private tocEntries: HTMLAnchorElement[] = [];
        private sections: (HTMLElement | null)[] = [];
        private headings: (HTMLElement | null)[] = [];
        private active: boolean[] = [];
        private activeIndicator: HTMLElement | null = null;
        private observer: IntersectionObserver;
        private tocContainer: HTMLElement | null = null;

        constructor() {
            this.tocContainer = document.getElementById("toc-entries");
            this.activeIndicator = document.getElementById(
                "toc-active-indicator",
            );
            this.tocEntries = Array.from(
                document.querySelectorAll<HTMLAnchorElement>(
                    ".toc-entry[data-heading-id]",
                ),
            );

            if (this.tocEntries.length === 0) return;

            this.sections = new Array(this.tocEntries.length);
            this.headings = new Array(this.tocEntries.length);

            for (let i = 0; i < this.tocEntries.length; i++) {
                const id = this.tocEntries[i].dataset.headingId;
                if (!id) continue;
                const heading = document.getElementById(id);
                const section = heading?.parentElement;
                if (heading instanceof HTMLElement) {
                    this.headings[i] = heading;
                    this.sections[i] = section instanceof HTMLElement ? section : heading;
                }
            }

            this.active = new Array(this.tocEntries.length).fill(false);

            this.observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        const id = entry.target.getAttribute("id") ||
                            entry.target.querySelector("[id]")?.getAttribute("id");
                        if (!id) continue;
                        const idx = this.tocEntries.findIndex(
                            (el) => el.dataset.headingId === id,
                        );
                        if (idx === -1) continue;
                        this.active[idx] = entry.isIntersecting;
                    }
                    this.update();
                },
                {
                    rootMargin: "-80px 0px -65% 0px",
                    threshold: 0,
                },
            );

            // Observe heading elements directly
            this.headings.forEach((heading) => {
                if (heading) this.observer.observe(heading);
            });

            this.fallback();
            this.update();
        }

        private fallback() {
            // If nothing is active, activate the first heading that's above the viewport center
            if (this.active.some((a) => a)) return;
            const viewportMiddle = window.innerHeight / 2;
            for (let i = this.headings.length - 1; i >= 0; i--) {
                const heading = this.headings[i];
                if (!heading) continue;
                const rect = heading.getBoundingClientRect();
                if (rect.top < viewportMiddle) {
                    this.active[i] = true;
                    break;
                }
            }
        }

        private update() {
            // Find the range of active entries
            let first = -1;
            let last = -1;

            for (let i = 0; i < this.active.length; i++) {
                if (this.active[i]) {
                    if (first === -1) first = i;
                    last = i;
                }
            }

            // Update entry classes
            this.tocEntries.forEach((entry, i) => {
                if (i >= first && i <= last && first !== -1) {
                    entry.classList.add("active");
                } else {
                    entry.classList.remove("active");
                }
            });

            // Update active indicator position
            if (first === -1 || !this.activeIndicator || !this.tocContainer) {
                if (this.activeIndicator) {
                    this.activeIndicator.style.opacity = "0";
                }
                return;
            }

            const containerRect = this.tocContainer.getBoundingClientRect();
            const firstRect = this.tocEntries[first].getBoundingClientRect();
            const lastRect = this.tocEntries[last].getBoundingClientRect();

            const top = firstRect.top - containerRect.top + this.tocContainer.scrollTop;
            const height = lastRect.bottom - firstRect.top;

            this.activeIndicator.style.top = `${top}px`;
            this.activeIndicator.style.height = `${height}px`;
            this.activeIndicator.style.opacity = "1";

            // Auto-scroll TOC if needed
            this.scrollTocIntoView(top, height);
        }

        private scrollTocIntoView(top: number, height: number) {
            if (!this.tocContainer) return;
            const containerHeight = this.tocContainer.clientHeight;
            const scrollTop = this.tocContainer.scrollTop;
            const itemCenter = top + height / 2;
            const viewCenter = scrollTop + containerHeight / 2;

            if (
                itemCenter < scrollTop + 40 ||
                itemCenter > scrollTop + containerHeight - 40
            ) {
                this.tocContainer.scrollTo({
                    top: itemCenter - containerHeight / 2,
                    behavior: "smooth",
                });
            }
        }

        disconnect() {
            this.observer.disconnect();
        }
    }

    // Initialize
    new TOCHighlighter();
</script>
